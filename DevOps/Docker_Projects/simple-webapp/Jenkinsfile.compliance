// Jenkinsfile.compliance

pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Fix Kubernetes Config') {
            steps {
                sh '''
                mkdir -p ~/.kube

                sed -i 's#https://127.0.0.1:54269#https://host.docker.internal:54269#g' ~/.kube/config

                kubectl config set-cluster kind-cicd-lab \
                  --server=https://host.docker.internal:54269 \
                  --insecure-skip-tls-verify=true

                kubectl config view --minify
                kubectl get nodes
                '''
            }
        }

        stage('Checkov Scan') {
            steps {
                dir('DevOps/Docker_Projects/simple-webapp') {
                    sh '''
                    mkdir -p reports

                    checkov -d . \
                    -o cli \
                    -o json \
                    --output-file-path console,reports/checkov-report.json || true
                    '''
                }
            }
        }

        stage('Semgrep Scan') {
            steps {
                dir('DevOps/Docker_Projects/simple-webapp') {
                    sh '''
                    semgrep --config auto . || true
                    '''
                }
            }
        }

        stage('Gitleaks Scan') {
            steps {
                dir('DevOps/Docker_Projects/simple-webapp') {
                    sh '''
                    gitleaks detect --source . --no-git || true
                    '''
                }
            }
        }

        stage('Kyverno Validation') {
            steps {
                sh '''
                kubectl get pods -n kyverno
                '''
            }
        }

        stage('Gatekeeper Validation') {
            steps {
                sh '''
                kubectl get pods -n gatekeeper-system
                '''
            }
        }

        stage('Falco Validation') {
            steps {
                sh '''
                kubectl get pods -n falco
                '''
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: 'DevOps/Docker_Projects/simple-webapp/reports/*', allowEmptyArchive: true
            }
        }
    }

    post {
        success {
            echo 'Compliance Pipeline Success'
        }

        failure {
            echo 'Compliance Pipeline Failed'
        }
    }
}