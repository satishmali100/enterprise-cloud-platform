// Jenkinsfile.compliance

pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Fix Kubernetes Config') {
            steps {
                sh '''
                mkdir -p ~/.kube

                sed -i 's#https://127.0.0.1:54269#https://host.docker.internal:54269#g' ~/.kube/config

                grep server ~/.kube/config

                kubectl get nodes
                '''
            }
        }

        stage('Checkov Scan') {
            steps {
                dir('DevOps/Docker_Projects/simple-webapp') {
                    sh '''
                    checkov -d .
                    '''
                }
            }
        }

        stage('Semgrep Scan') {
            steps {
                dir('DevOps/Docker_Projects/simple-webapp') {
                    sh '''
                    semgrep --config auto .
                    '''
                }
            }
        }

        stage('Gitleaks Scan') {
            steps {
                dir('DevOps/Docker_Projects/simple-webapp') {
                    sh '''
                    gitleaks detect --source . --no-git
                    '''
                }
            }
        }

        stage('Kyverno Validation') {
            steps {
                sh '''
                kubectl get pods -n kyverno
                '''
            }
        }

        stage('Gatekeeper Validation') {
            steps {
                sh '''
                kubectl get pods -n gatekeeper-system
                '''
            }
        }

        stage('Falco Validation') {
            steps {
                sh '''
                kubectl get pods -n falco
                '''
            }
        }
    }

    post {
        success {
            echo 'Compliance Pipeline Success'
        }

        failure {
            echo 'Compliance Pipeline Failed'
        }
    }
}