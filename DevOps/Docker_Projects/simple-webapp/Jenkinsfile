pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Code received from GitHub'
            }
        }

        stage('Validate Files') {
            steps {
                sh 'ls -la DevOps/Docker_Projects/simple-webapp'
            }
        }

        stage('CI Completed') {
            steps {
                echo 'GitHub webhook to Jenkins automation is working'
            }
        }
    }
}