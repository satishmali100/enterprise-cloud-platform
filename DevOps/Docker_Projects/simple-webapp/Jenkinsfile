pipeline {
    agent any

    stages {
        stage('Build Docker Image') {
            steps {
                sh 'docker build --no-cache -t enterprise-webapp-jenkins:v1 DevOps/Docker_Projects/simple-webapp'
            }
        }

        stage('Load Image Into Kind') {
            steps {
                sh 'kind load docker-image enterprise-webapp-jenkins:v1 --name cicd-lab'
            }
        }

        stage('Deploy To Kubernetes') {
            steps {
                sh 'kubectl --kubeconfig=/var/jenkins_home/.kube/config apply -f DevOps/Docker_Projects/simple-webapp/k8s/'
                sh 'kubectl --kubeconfig=/var/jenkins_home/.kube/config rollout restart deployment enterprise-webapp-deployment'
                sh 'kubectl --kubeconfig=/var/jenkins_home/.kube/config rollout status deployment enterprise-webapp-deployment'
            }
        }
    }
}