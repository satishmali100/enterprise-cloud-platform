pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'ROLLBACK',
            defaultValue: false,
            description: 'Tick only if you want to rollback previous Kubernetes deployment'
        )
    }

    environment {
        APP_DIR = 'DevOps/Docker_Projects/simple-webapp'
        APP_NAME = 'enterprise-webapp'
        IMAGE_REPO = 'enterprise-webapp-jenkins'
        IMAGE_TAG = "build-${BUILD_NUMBER}"
        K8S_DEPLOYMENT = 'enterprise-webapp-deployment'
        KIND_CLUSTER = 'cicd-lab'
    }

    stages {

        stage('Rollback') {
            when { expression { params.ROLLBACK == true } }
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    echo "Manual rollback started..."
                    kubectl rollout undo deployment ${K8S_DEPLOYMENT}
                    kubectl rollout status deployment ${K8S_DEPLOYMENT}
                    echo "Rollback completed."
                    '''
                }
            }
        }

        stage('Secret Scan - Gitleaks') {
            when { expression { params.ROLLBACK == false } }
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    echo "Running Gitleaks secret scan..."
                    gitleaks detect --source . --no-git --redact --exit-code 0
                    '''
                }
            }
        }

        stage('SAST Scan - Semgrep') {
            when { expression { params.ROLLBACK == false } }
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    echo "Running Semgrep SAST scan..."
                    semgrep scan --config auto . || true
                    '''
                }
            }
        }

        stage('IaC Scan - Checkov') {
            when { expression { params.ROLLBACK == false } }
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    echo "Running Checkov IaC scan..."
                    checkov -d . --quiet || true
                    '''
                }
            }
        }

        stage('Docker Build') {
            when { expression { params.ROLLBACK == false } }
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    IMAGE_NAME=${IMAGE_REPO}:${IMAGE_TAG}
                    echo "Building Docker image: $IMAGE_NAME"
                    docker build -t $IMAGE_NAME .
                    '''
                }
            }
        }

        stage('Trivy Image Scan') {
            when { expression { params.ROLLBACK == false } }
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    IMAGE_NAME=${IMAGE_REPO}:${IMAGE_TAG}
                    echo "Running Trivy image scan..."
                    trivy image --timeout 10m --severity HIGH,CRITICAL --exit-code 0 $IMAGE_NAME
                    '''
                }
            }
        }

        stage('Archive Artifacts') {
            when { expression { params.ROLLBACK == false } }
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    echo "Creating build artifacts..."
                    rm -rf build-artifacts
                    mkdir -p build-artifacts

                    cp index.html build-artifacts/
                    cp Dockerfile build-artifacts/
                    cp k8s/deployment.yaml build-artifacts/
                    cp k8s/service.yaml build-artifacts/
                    '''
                    archiveArtifacts artifacts: 'build-artifacts/**', fingerprint: true
                }
            }
        }

        stage('Load Image Into kind') {
            when { expression { params.ROLLBACK == false } }
            steps {
                sh '''
                IMAGE_NAME=${IMAGE_REPO}:${IMAGE_TAG}
                echo "Loading image into kind: $IMAGE_NAME"
                kind load docker-image $IMAGE_NAME --name ${KIND_CLUSTER}
                '''
            }
        }

        stage('Kubernetes Deploy') {
            when { expression { params.ROLLBACK == false } }
            steps {
                dir("${APP_DIR}") {
                    sh '''
                    IMAGE_NAME=${IMAGE_REPO}:${IMAGE_TAG}

                    echo "Applying Kubernetes manifests..."
                    kubectl apply -f k8s/service.yaml
                    kubectl apply -f k8s/deployment.yaml

                    echo "Updating deployment image..."
                    kubectl set image deployment/${K8S_DEPLOYMENT} ${APP_NAME}=$IMAGE_NAME
                    '''
                }
            }
        }

        stage('Rollout Status') {
            when { expression { params.ROLLBACK == false } }
            steps {
                sh '''
                echo "Checking Kubernetes rollout status..."
                kubectl rollout status deployment/${K8S_DEPLOYMENT}
                kubectl get pods
                kubectl describe deployment ${K8S_DEPLOYMENT} | grep Image
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully."
        }

        failure {
            echo "Pipeline failed. Check console logs."
        }

        always {
            echo "Pipeline finished."
        }
    }
}