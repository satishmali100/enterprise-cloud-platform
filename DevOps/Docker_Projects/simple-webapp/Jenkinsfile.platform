// Jenkinsfile.platform

pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Fix Kubernetes Config') {
            steps {
                sh '''
                mkdir -p ~/.kube

                sed -i 's#https://127.0.0.1:54269#https://host.docker.internal:54269#g' ~/.kube/config

                grep server ~/.kube/config

                kubectl get nodes
                '''
            }
        }

        stage('Platform Validation') {
            steps {
                sh '''
                kubectl get nodes
                kubectl get pods -A
                kubectl top nodes || true
                '''
            }
        }

        stage('Helm Validation') {
            steps {
                sh '''
                helm repo list
                helm list -A
                '''
            }
        }
    }

    post {
        success {
            echo 'Platform Pipeline Success'
        }

        failure {
            echo 'Platform Pipeline Failed'
        }
    }
}